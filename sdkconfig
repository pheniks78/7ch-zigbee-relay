#
# ESP-IDF SDK configuration for 7ch-zigbee-relay
# Target: ESP32-H2 (4MB flash variant)
#
CONFIG_IDF_TARGET="esp32h2"
CONFIG_IDF_TARGET_ESP32H2=y

# Zigbee stack
CONFIG_ZB_ENABLED=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_ZR=y
CONFIG_ZB_ZIGBEE_ON_OFF_LIGHT=y

# Flash size: 4MB board (ESP32-H2 Super Mini)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_OTA_ALLOW_LIST=y
CONFIG_APP_OTA_SUPPORT=y

# GPIO
CONFIG_GPIO_ENABLED=y

# NVS / storage
CONFIG_NVS_ENABLED=y

# Logging
CONFIG_LOG_MAXIMUM_LEVEL=INFO
CONFIG_LOG_ENABLED=y

# Memory optimizations
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_OPTIMIZE_ASSERTIONS=y

# Bootloader
CONFIG_BOOTLOADER=y